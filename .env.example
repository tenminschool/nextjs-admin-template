# Backend selector — combined in next.config.ts to derive service URLs.
# prod  → NEXT_PUBLIC_API_PREFIX=,        NEXT_PUBLIC_DOMAIN=.com,  NEXT_PUBLIC_ENVIRONMENT=prod
# stage → NEXT_PUBLIC_API_PREFIX=stage-,  NEXT_PUBLIC_DOMAIN=.net,  NEXT_PUBLIC_ENVIRONMENT=stage
# local → NEXT_PUBLIC_API_PREFIX=local-,  NEXT_PUBLIC_DOMAIN=.net,  NEXT_PUBLIC_ENVIRONMENT=local
NEXT_PUBLIC_API_PREFIX=local-
NEXT_PUBLIC_ENVIRONMENT=local
NEXT_PUBLIC_DOMAIN=.net

# Google OAuth client ID (must include this app's origin in authorized JS origins)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Identifier sent on the X-TENMS-SOURCE-PLATFORM request header
NEXT_PUBLIC_TENMS_SOURCE_PLATFORM=admin

# Site URLs per environment (used for CORS, redirects, etc.)
NEXT_PUBLIC_SITE_URL_prod=https://admin.10minuteschool.com
